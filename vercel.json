{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "functions/trpc.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/trpc/:path*", "destination": "/functions/trpc" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
